<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Proxy WebSocket Socket.IO ---
  RewriteCond %{HTTP:Upgrade} websocket [NC]
  RewriteCond %{HTTP:Connection} upgrade [NC]
  RewriteRule ^socket\.io/(.*)$ ws://127.0.0.1:8000/socket.io/$1 [P,L]

  # --- Proxy HTTP → FastAPI (port 8000) ---
  RewriteRule ^api/(.*)$       http://127.0.0.1:8000/api/$1       [P,L]
  RewriteRule ^socket\.io/(.*)$ http://127.0.0.1:8000/socket.io/$1 [P,L]

  # --- SPA fallback : toutes les autres routes → index.html ---
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
